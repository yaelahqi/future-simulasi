# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Exchange Configuration
EXCHANGE_ID=binance
# API keys NOT needed for paper trading (optional)
# Only required if you enable live trading later
API_KEY=  # Optional - leave empty for paper trading
API_SECRET=  # Optional - leave empty for paper trading

# Trading Configuration
INITIAL_CAPITAL=10.00
LEVERAGE=10
MAX_POSITION_SIZE=100

# Symbols to Track (comma-separated)
SYMBOLS=SOL/USDT,BTC/USDT,ETH/USDT

# Signal Settings
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MA_PERIOD=20
TIMEFRAME=15m

# Paper Trading Settings
PAPER_TRADING=true
TAKE_PROFIT_PCT=5.0
STOP_LOSS_PCT=5.0

# Log Settings
LOG_FILE=logs/trades.log
LOG_LEVEL=INFO

# Screening Settings
SCREENING_ENABLED=true
SCREENING_MIN_VOLUME=1000000
TOP_N_COINS=10

# Risk Management
MAX_POSITIONS=3              # Max concurrent positions (1-5 recommended)
MAX_DAILY_LOSS_PCT=20.0      # Stop trading if -20% in a day
POSITION_SIZE_PCT=33.0       # % of capital per trade (100%=1pos, 50%=2pos, 33%=3pos)
MAX_LEVERAGE=10              # Hard cap on leverage
TRADING_ENABLED=true         # Global trading toggle (/pause and /resume commands)
