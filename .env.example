# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Exchange Configuration
EXCHANGE_ID=binance
# Market type for ccxt: "future" (USDT-M perpetuals, matches the simulator's
# fee/leverage/liquidation model) or "spot". Leave as "future" for realistic
# perp-style PnL; switch to "spot" only for testing on spot OHLCV.
MARKET_TYPE=future

# Trading Configuration
INITIAL_CAPITAL=10.00
LEVERAGE=10

# Symbols to Track (comma-separated, used when SCREENING_ENABLED=false)
SYMBOLS=SOL/USDT,BTC/USDT,ETH/USDT

# Signal Settings
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MA_PERIOD=20
TIMEFRAME=15m

# Paper Trading Settings
PAPER_TRADING=true
TAKE_PROFIT_PCT=5.0
STOP_LOSS_PCT=5.0

# Realism (Futures USDT-M defaults: ~0.04% taker fee, ~2 bps slippage)
TAKER_FEE_PCT=0.04
SLIPPAGE_BPS=2.0

# Log Settings
LOG_FILE=logs/trades.log
LOG_LEVEL=INFO
STATE_FILE=paper_trader_state.json

# Screening Settings
SCREENING_ENABLED=true
SCREENING_MIN_VOLUME=1000000
TOP_N_COINS=10

# Risk Management
MAX_POSITIONS=3              # Max concurrent positions (1-5 recommended)
MAX_DAILY_LOSS_PCT=20.0      # Stop trading if -20% (relative to start-of-day equity)
POSITION_SIZE_PCT=33.0       # % of TOTAL equity per trade
MAX_LEVERAGE=10              # Hard cap on leverage
TRADING_ENABLED=true         # Global trading toggle (/pause and /resume commands)

# Loop intervals (seconds)
SCAN_INTERVAL=120            # signal scan period
POSITION_CHECK_INTERVAL=15   # near-real-time TP/SL polling
SCREENING_INTERVAL=1800      # full screening every 30 min
SCREENING_COOLDOWN=300       # min seconds between re-screen triggers
SUMMARY_INTERVAL=3600        # periodic summary
BLACKLIST_DURATION=1800      # 30 min blacklist after SL hit
COMMAND_INTERVAL=5           # Telegram command poll period
SIGNAL_RATE_LIMIT=300        # min seconds between signals per symbol

# Networking
HTTP_TIMEOUT=15              # requests.get/post timeout in seconds
